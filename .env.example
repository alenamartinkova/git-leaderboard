# Copy to .env and fill in.

# GitHub — jedna organizácia:
GITHUB_ORG=your-org-name
GITHUB_TOKEN=ghp_yourtokenhere

# ...alebo viac organizácií naraz (čiarkou oddelené):
# GITHUB_ORGS=EsportDynamics,DruhaFirma
#
# Token per organizácia: GITHUB_TOKEN_<ORG>, kde <ORG> je názov veľkými písmenami
# a všetko, čo nie je písmeno/číslica, sa nahradí podčiarkovníkom
# (Druha-Firma -> GITHUB_TOKEN_DRUHA_FIRMA).
# GITHUB_TOKEN_ESPORTDYNAMICS=github_pat_...
# GITHUB_TOKEN_DRUHAFIRMA=github_pat_...
#
# GITHUB_TOKEN sa použije pre orgy, ktoré vlastný token nemajú.

# Postgres
# - When running the app in docker compose, DATABASE_URL is overridden to use host `db`.
# - This value is used for local dev (uvicorn outside docker, Postgres in docker).
DATABASE_URL=postgresql+psycopg://leaderboard:leaderboard@localhost:5432/leaderboard

# Sync schedule (cron format, server timezone)
SYNC_CRON_HOUR=3
SYNC_CRON_MINUTE=0

# Repos to skip during sync (comma-separated, fnmatch globs against repo name)
SYNC_EXCLUDE_PATTERNS=*-config,tf-org,tf-infra

# How far back a backfill walks. 0 = celá história repa (od prvého commitu).
# Kladné číslo = strop v dňoch.
SYNC_HISTORY_DAYS=0

# Koľko commitov naraz pýtať z GraphQL. Pri 502 (repo s veľa branchami) si to
# appka sama zníži na 50/25/12/10 — toto je len štartovacia hodnota.
SYNC_PAGE_SIZE=100

# Koľko dní dozadu prekrýva inkrementálny (nočný) sync — pokrýva rebase/force-push.
SYNC_OVERLAP_DAYS=21

# Prihlásenie do appky (HTTP Basic). Nechaj prázdne = bez loginu.
# Platí na celú appku vrátane /api/* (výnimka: /healthz).
AUTH_USER=
AUTH_PASSWORD=

# Origins, ktoré smú volať /api/* z prehliadača (vlastný frontend na inej doméne).
# Prázdne = CORS vypnuté. Príklad: http://localhost:5173,https://dashboard.firma.sk
API_CORS_ORIGINS=

# Docker Compose: read by `docker compose` directly (not by the app).
# Uncomment to always apply the dev override (exposes db on 5433, enables --reload).
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
