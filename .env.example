# Copy to .env and fill in.

# GitHub
GITHUB_TOKEN=ghp_yourtokenhere
GITHUB_ORG=your-org-name

# Postgres
# - When running the app in docker compose, DATABASE_URL is overridden to use host `db`.
# - This value is used for local dev (uvicorn outside docker, Postgres in docker).
DATABASE_URL=postgresql+psycopg://leaderboard:leaderboard@localhost:5432/leaderboard

# Sync schedule (cron format, server timezone)
SYNC_CRON_HOUR=3
SYNC_CRON_MINUTE=0
